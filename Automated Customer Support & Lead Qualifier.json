    {
      "parameters": {
        "jsCode": "// بياخد النص من الـ AI وبيحوله لـ JSON حقيقي نقدر نستخدمه في الـ Workflow\ntry {\n  const rawOutput = $input.first().json.output || \"\";\n  // تنظيف أي backticks أو كلام زائد\n  const cleanString = rawOutput.replace(/```json|```/g, '').trim();\n  const cleanJson = JSON.parse(cleanString);\n  \n  return [{ json: cleanJson }];\n} catch (error) {\n  // في حالة لو الموديل خرج نص غير قابل للتحليل\n  return [{\n    json: {\n      error: \"Failed to parse JSON\",\n      raw_output: $input.first().json.output\n    }\n  }];\n}"
      },
